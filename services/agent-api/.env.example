# Copy to .env.local (gitignored). Nothing here is required for the offline demo or the tests.

# Language model: any OpenAI-compatible endpoint. Default base URL is Gemini's OpenAI-compatible API.
LLM_API_KEY=<from your provider, never commit>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# LLM_TIMEOUT_SECONDS=40
# Alternative: Vercel AI Gateway (AI_GATEWAY_API_KEY or the project's VERCEL_OIDC_TOKEN)

# Data: fixtures (default without a database) or db
TESTOPS_DATA_SOURCE=fixtures
# Read-only role used by the API (created by `python -m app.seed` when READONLY_PASSWORD is set)
# DATABASE_URL_READONLY=postgresql://testops_reader:<password>@<host>/<db>?sslmode=require
# Privileged URL, only for `python -m app.seed`
# DATABASE_URL=postgresql://<owner>:<password>@<host>/<db>?sslmode=require
# READONLY_PASSWORD=<generate one>

# Public demo protection
# RATE_LIMIT_PER_MINUTE=6
# LIVE_DAILY_CAP=150
