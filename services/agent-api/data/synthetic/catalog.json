  "release_policy": {
    "id": "release-policy-v3",
    "name": "Tier-1 release gate v3",
    "rules": {
      "gating_suites": [
        "critical"
      ],
      "unresolved_failure": "BLOCK",
      "source_conflict": "HOLD_MANUAL_REVIEW",
      "incomplete_evidence": "HOLD_MANUAL_REVIEW",
      "retry_pass_warn_threshold": 1,
      "missing_ci_summary": "HOLD_MANUAL_REVIEW"
    },
    "source_of_truth": [
      "test-runner attempt results (final attempt per test)",
      "CI summary webhook (advisory only)",
      "artifact logs (context only, never decisive)"
    ]
